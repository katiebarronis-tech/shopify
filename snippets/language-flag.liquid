{%- comment -%}
  Renders a small flag for a language.

  Accepts:
    - iso_code: the language ISO code (e.g. 'en', 'es')
{%- endcomment -%}
{%- assign code = iso_code | split: '-' | first | downcase -%}
<span class="language-flag" aria-hidden="true">
  {%- case code -%}
    {%- when 'es' -%}
      <svg viewBox="0 0 30 20" focusable="false">
        <rect width="30" height="20" fill="#AA151B"/>
        <rect y="5" width="30" height="10" fill="#F1BF00"/>
      </svg>
    {%- when 'en' -%}
      <svg viewBox="0 0 60 30" focusable="false">
        <clipPath id="LanguageFlagUkClip"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath>
        <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
        <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#LanguageFlagUkClip)" stroke="#C8102E" stroke-width="4"/>
        <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
        <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
      </svg>
  {%- endcase -%}
</span>
